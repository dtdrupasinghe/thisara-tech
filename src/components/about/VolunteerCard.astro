---
import Logo from './Logo.astro';
import type { Volunteering } from '../../data/volunteering';
import { filled } from '../../placeholders';

interface Props {
  item: Volunteering;
  index?: number;
}

const { item, index = 0 } = Astro.props;
const sub = filled(item.sub);
const roles = item.roles.filter((r) => filled(r.role));
---

<article class:list={['ab-card', 'ab-vol', { 'is-featured': item.featured }]} style={`--i: ${index}`}>
  <div class="ab-vol-head">
    <Logo src={item.logo} alt={`${item.org} logo`} initials={item.initials} size={48} />
    <div>
      <h3>{item.org}</h3>
      {sub && <p class="ab-muted">{sub}</p>}
    </div>
  </div>
  {roles.length > 0 && (
    <ol class="ab-roles">
      {roles.map((r) => (
        <li>
          <span class="ab-role">{r.role}</span>
          {filled(r.dates) && <span class="ab-meta">{r.dates}</span>}
        </li>
      ))}
    </ol>
  )}
</article>
