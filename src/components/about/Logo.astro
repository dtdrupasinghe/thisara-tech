---
// A logo from public/images, or the initials when that file doesn't exist yet (checked at build time).
import { publicImage } from '../../utils';

interface Props {
  src?: string;
  alt: string;
  initials: string;
  size: 48 | 64;
}

const { src, alt, initials, size } = Astro.props;
const image = publicImage(src);
const classes = ['ab-logo', `ab-logo-${size}`];
---

{image ? (
  <img class:list={classes} src={image} alt={alt} width={size} height={size} loading="lazy" decoding="async" />
) : (
  <span class:list={[...classes, 'ab-initials']} aria-hidden="true">{initials}</span>
)}
