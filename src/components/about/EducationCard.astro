---
import Icon from './Icon.astro';
import Pill from './Pill.astro';
import type { Education } from '../../data/education';
import { dateRange, filled, filledList } from '../../placeholders';
import { publicImage } from '../../utils';

interface Props {
  item: Education;
  index?: number;
}

const { item, index = 0 } = Astro.props;
const logo = publicImage(item.logo);
const status = filled(item.status);
const place = [filled(item.school), filled(item.location)].filter(Boolean).join(' · ');
const dates = dateRange(item.start, item.end);
const research = filledList(item.research);
---

<article class="ab-card ab-edu" style={`--i: ${index}`}>
  {logo ? (
    <img class="ab-edu-logo" src={logo} alt={`${item.school} logo`} width="180" height="96" loading="lazy" decoding="async" />
  ) : (
    <div class="ab-edu-icon" aria-hidden="true"><Icon name="cap" size={44} /></div>
  )}
  <div>
    <div class="ab-title-row">
      <h3>{item.degree}</h3>
      {status && <Pill>{status}</Pill>}
    </div>
    {place && <p class="ab-muted">{place}</p>}
    {dates && <p class="ab-meta">{dates}</p>}
    {research.length > 0 && (
      <>
        <h4 class="ab-label">Research</h4>
        <ul class="ab-list">
          {research.map((r) => <li>{r}</li>)}
        </ul>
      </>
    )}
  </div>
</article>
