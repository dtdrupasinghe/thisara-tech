---
// Icon-only links to the profiles in SOCIAL_LINKS. The SVG paths are inlined at build time.
import { SOCIAL_LINKS } from '../consts';
import { SOCIAL_ICON_PATHS as PATHS } from '../social-icons';

interface Props {
  class?: string;
}

const { class: extra } = Astro.props;

const links = SOCIAL_LINKS.filter((link) => PATHS[link.icon]);
---

<ul class:list={['social-icons', extra]}>
  {links.map((link) => (
    <li>
      <a href={link.href} target="_blank" rel="me noopener" aria-label={`${link.label} (opens in a new tab)`}>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d={PATHS[link.icon]} />
        </svg>
      </a>
    </li>
  ))}
</ul>
