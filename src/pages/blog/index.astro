---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../utils';

const posts = await getPosts();
---

<Base title="Blog" description="All posts on Azure, cloud cost and developer tools.">
  <section class="wrap">
    <header class="page-head">
      <h1>All posts</h1>
      <p class="lead">{posts.length} {posts.length === 1 ? 'post' : 'posts'} on Azure, FinOps and developer tools.</p>
      <p id="search-status" class="search-status" role="status" hidden></p>
    </header>
    <ul class="card-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </ul>
  </section>

  <script is:inline>
    (function () {
      var q = new URLSearchParams(location.search).get('q');
      if (!q) return;
      var term = q.trim().toLowerCase();
      var n = 0;
      document.querySelectorAll('[data-search]').forEach(function (li) {
        var match = li.getAttribute('data-search').indexOf(term) !== -1;
        li.hidden = !match;
        if (match) n++;
      });
      var status = document.getElementById('search-status');
      status.hidden = false;
      status.textContent = n + (n === 1 ? ' result' : ' results') + ' for "' + q + '"';
      var input = document.getElementById('q');
      if (input) input.value = q;
    })();
  </script>
</Base>
