---
import Base from '../layouts/Base.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import PostCard from '../components/PostCard.astro';
import Stats from '../components/Stats.astro';
import VideoCard from '../components/VideoCard.astro';
import { Image } from 'astro:assets';
import { getPosts } from '../utils';
import { getLatestVideos } from '../youtube';
import heroPhoto from '../assets/hero-photo.webp';
import { CATEGORIES, DEFAULT_COVER, ROLES, SOCIAL_LINKS } from '../consts';

const posts = await getPosts();
const videos = await getLatestVideos();
// Only categories that have posts; the rest appear once a post uses that tag.
const categories = CATEGORIES.map((c) => ({
  ...c,
  count: posts.filter((p) => p.data.tags.includes(c.tag)).length,
})).filter((c) => c.count > 0);
// Each letter gets its own delay (--i) so the name types in one after another.
let letter = 0;
const nameWords = 'Thisara Rupasinghe'.split(' ').map((w) => [...w].map((ch) => ({ ch, i: letter++ })));
---

<Base>
  <section class="hero hero-home" aria-labelledby="hero-title">
    <img class="hero-bg" src={DEFAULT_COVER} alt="" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1 id="hero-title" class="hero-title" aria-label="Hi, I'm Thisara Rupasinghe">
          <span class="hi" aria-hidden="true">Hi, I'm</span>
          <span class="hl name" aria-hidden="true">
            {nameWords.map((word, w) => (
              <>{w > 0 && ' '}<span class="word">{word.map((l) => <span class="ch" style={`--i:${l.i}`}>{l.ch}</span>)}</span></>
            ))}
          </span>
        </h1>
        <p class="hero-role">
          <span class="sr-only">{ROLES.join(', ')}</span>
          <span class="role-text" aria-hidden="true" data-roles={JSON.stringify(ROLES)}>{ROLES[0]}</span><span class="role-cursor" aria-hidden="true"></span>
        </p>
        <p class="hero-desc">Based in Sri Lanka. I write about tech updates, Azure, cloud cost and free tools for students and engineers.</p>
        <div class="hero-actions">
          <a class="btn" href="/blog/">Read the posts</a>
          <a class="btn btn-ghost" href="/about/">About me</a>
        </div>
      </div>
      <div class="hero-portrait">
        <div class="portrait-glow" aria-hidden="true"></div>
        <Image class="portrait-ghost ghost-left" src={heroPhoto} alt="" aria-hidden="true" widths={[340, 480, 680, 900]} sizes="(max-width: 720px) 86vw, 520px" loading="eager" />
        <Image class="portrait-ghost ghost-right" src={heroPhoto} alt="" aria-hidden="true" widths={[340, 480, 680, 900]} sizes="(max-width: 720px) 86vw, 520px" loading="eager" />
        <Image
          class="portrait-img"
          src={heroPhoto}
          alt="Thisara Rupasinghe smiling, wearing a dark suit and blue tie"
          widths={[340, 480, 680, 900]}
          sizes="(max-width: 720px) 86vw, 520px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="hero-fade" aria-hidden="true"></div>
  </section>

  <Stats />

  {videos.length > 0 && (
    <section class="wrap" aria-labelledby="youtube">
      <div class="section-head">
        <h2 id="youtube">Latest on YouTube</h2>
        <div class="slider-nav" hidden>
          <button class="slider-btn" type="button" data-dir="-1" aria-label="Scroll videos left">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
          </button>
          <button class="slider-btn" type="button" data-dir="1" aria-label="Scroll videos right">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
          </button>
        </div>
      </div>
      <ul class="video-track">
        {videos.map((video) => <VideoCard video={video} />)}
      </ul>
      <p class="video-more"><a href="/videos/">See all videos →</a></p>
    </section>
  )}

  {posts.length > 0 && (
    <section class="wrap" aria-labelledby="latest">
      <div class="section-head">
        <h2 id="latest">Latest posts</h2>
        <a href="/blog/">All posts →</a>
      </div>
      <ul class="card-grid">
        {posts.slice(0, 6).map((post) => <PostCard post={post} />)}
      </ul>
    </section>
  )}

  <NewsletterSignup class="wrap" />

  {categories.length > 0 && (
    <section class="wrap" aria-labelledby="categories">
      <div class="section-head">
        <h2 id="categories">Categories</h2>
      </div>
      <ul class="cat-grid">
        {categories.map((c) => (
          <li>
            <a class="cat-card" href={`/tags/${c.tag}/`}>
              <span class="cat-name">{c.label}</span>
              <span class="cat-desc">{c.desc}</span>
              <span class="cat-count">{c.count} {c.count === 1 ? 'post' : 'posts'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap" aria-labelledby="contact">
    <div class="contact-card">
      <div>
        <h2 id="contact">Get in touch</h2>
        <p>Have a question about a post, an idea for a topic, or want me to speak at your event? Send me a message or find me here.</p>
      </div>
      <ul class="contact-links">
        <li><a class="btn" href="/contact/">Send a message</a></li>
        {SOCIAL_LINKS.map((s) => <li><a class="btn btn-ghost" href={s.href} rel="me noopener">{s.label}</a></li>)}
        <li><a class="btn btn-ghost" href="/about/">About me</a></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // Arrow buttons for the YouTube slider. Without JS the row still scrolls by swipe or trackpad.
  const track = document.querySelector<HTMLElement>('.video-track');
  const nav = document.querySelector<HTMLElement>('.slider-nav');
  if (track && nav) {
    nav.hidden = false;
    nav.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (btn) track.scrollBy({ left: Number(btn.dataset.dir) * track.clientWidth * 0.85 });
    });
  }
</script>

<script>
  // Types each role, holds it, deletes it, then moves to the next. Without JS the first role stays.
  const el = document.querySelector<HTMLElement>('.role-text');
  const roles: string[] = el ? JSON.parse(el.dataset.roles ?? '[]') : [];
  if (el && roles.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let r = 0;
    let n = roles[0].length;
    let deleting = true;
    const tick = () => {
      const word = roles[r];
      n += deleting ? -1 : 1;
      el.textContent = word.slice(0, n);
      let wait = deleting ? 35 : 75;
      if (!deleting && n === word.length) { deleting = true; wait = 1800; }
      else if (deleting && n === 0) { deleting = false; r = (r + 1) % roles.length; wait = 300; }
      setTimeout(tick, wait);
    };
    setTimeout(tick, 2600);
  }
</script>
